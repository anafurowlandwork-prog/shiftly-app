# Shiftly Real-Time Production Environment Configuration

# 1. Firebase Cloud Firestore & Auth Config (Optional - will use resilient fallback if empty)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=shiftly-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=shiftly-app
VITE_FIREBASE_STORAGE_BUCKET=shiftly-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# 2. Stripe Payments & Stripe Connect Config
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# 3. Backend Realtime Engine
PORT=3001
VITE_BACKEND_API_URL=/api
