# Shiftly Real-Time Production Environment Configuration

# 1. SMS Providers (Twilio / Termii / MessageBird / Vonage)
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567

# Optional Alternative SMS Gateways:
# TERMII_API_KEY=your_termii_api_key
# MESSAGEBIRD_API_KEY=your_messagebird_api_key
# VONAGE_API_KEY=your_vonage_api_key
# VONAGE_API_SECRET=your_vonage_api_secret

# 2. Transactional Email Providers (Resend / SendGrid / Postmark)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Shiftly Logistics <notifications@shiftly.app>

# Optional Alternative Email Gateways:
# SENDGRID_API_KEY=SG.your_sendgrid_api_key
# POSTMARK_SERVER_TOKEN=your_postmark_server_token

# 3. Multimodal Vision AI (Gemini 2.0 Flash for Spatial & Weight Scanning)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key

# 4. Stripe Payments & Stripe Connect Payouts
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# 5. Firebase Cloud Firestore & Auth Config (Optional)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=shiftly-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=shiftly-app
VITE_FIREBASE_STORAGE_BUCKET=shiftly-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# 6. Backend Engine
PORT=3001
VITE_BACKEND_API_URL=/api
